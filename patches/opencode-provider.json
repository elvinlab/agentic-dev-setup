{
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "elvinlabCode": {
          "name": "elvinlabCode"
        },
        "elvinlabFast": {
          "name": "elvinlabFast"
        },
        "elvinlabLocal": {
          "name": "elvinlabLocal"
        }
      }
    }
  },
  "model": "omniroute/elvinlabCode",
  "small_model": "omniroute/elvinlabFast",
  "permission": {
    "doom_loop": "deny"
  },
  "agent": {
    "build": {
      "steps": 200
    },
    "gentle-ai-worker": {
      "steps": 200
    },
    "gentle-orchestrator": {
      "steps": 200
    }
  }
}
